{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "needs_review"]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "summary": {"type": "string"}
        },
        "required": ["command", "status", "summary"],
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_action": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "changed_files",
    "tests",
    "risks",
    "next_action"
  ],
  "additionalProperties": false
}
